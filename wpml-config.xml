<wpml-config>
  <elementor-widgets>

    <!-- Accordion -->
    <widget name="themeasy-accordion">
      <fields>
        <field>accordion_items>title</field>
        <field>accordion_items>description</field>
      </fields>
    </widget>

    <!-- Blockquote -->
    <widget name="themeasy-blockquote">
      <fields>
        <field>quote_text</field>
        <field>author_name</field>
        <field>author_role</field>
      </fields>
    </widget>

    <!-- Button -->
    <widget name="themeasy-button">
      <fields>
        <field>button_label</field>
        <field>button_hidden_label</field>
        <field>cursor_text</field>
      </fields>
    </widget>

    <!-- Call to Action -->
    <widget name="themeasy-cta">
      <fields>
        <field>badge_text</field>
        <field>pre_title</field>
        <field>title</field>
        <field>description</field>
        <field>primary_button_label</field>
        <field>secondary_button_label</field>
      </fields>
    </widget>

    <!-- Card -->
    <widget name="themeasy-card">
      <fields>
        <field>title</field>
        <field>description</field>
        <field>button_label</field>
        <field>button_hidden_label</field>
      </fields>
    </widget>

    <!-- Divider -->
    <widget name="themeasy-divider">
      <fields>
        <field>element_text</field>
      </fields>
    </widget>

    <!-- Icon List -->
    <widget name="themeasy-icon-list">
      <fields>
        <field>icon_list>text</field>
        <field>icon_list>counter</field>
      </fields>
    </widget>

    <!-- Image -->
    <widget name="themeasy-image">
      <fields>
        <field>image_caption</field>
        <field>cursor_text</field>
      </fields>
    </widget>

    <!-- Pricing Table -->
    <widget name="themeasy-pricing-table">
      <fields>
        <field>toggle_label_off</field>
        <field>toggle_label_on</field>
        <field>toggle_label_on_badge</field>
        <field>pricing_table>plan_name</field>
        <field>pricing_table>price_prefix</field>
        <field>pricing_table>price_suffix</field>
        <field>pricing_table>featured_badge_text</field>
        <field>pricing_table>features_list</field>
        <field>pricing_table>button_label</field>
        <field>pricing_table>button_hidden_label</field>
      </fields>
    </widget>

    <!-- Steps -->
    <widget name="themeasy-steps">
      <fields>
        <field>steps_items>title</field>
        <field>steps_items>content</field>
      </fields>
    </widget>

    <!-- Team Member -->
    <widget name="themeasy-team-member">
      <fields>
        <field>member_name</field>
        <field>member_role</field>
        <field>member_bio</field>
        <field>socials>social_label</field>
      </fields>
    </widget>

    <!-- Testimonial -->
    <widget name="themeasy-testimonial">
      <fields>
        <field>person_name</field>
        <field>occupation_info</field>
        <field>testimonial_text</field>
        <field>cursor_text</field>
      </fields>
    </widget>

  </elementor-widgets>
</wpml-config>
