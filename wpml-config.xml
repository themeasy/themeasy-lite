<wpml-config>
  <!-- Generated by `npm run wpml-config` (scripts/wpml-config.mjs) from the widgets' controls: do not edit by hand. -->
  <elementor-widgets>

    <!-- Accordion -->
    <widget name="themeasy-accordion">
      <fields-in-item items_of="accordion_items">
        <field type="Accordion: Title" editor_type="AREA">title</field>
        <field type="Accordion: Description" editor_type="VISUAL">description</field>
      </fields-in-item>
    </widget>

    <!-- Blockquote -->
    <widget name="themeasy-blockquote">
      <fields>
        <field type="Blockquote: Quote" editor_type="AREA">quote_text</field>
        <field type="Blockquote: Citation URL" editor_type="LINK">cite_url>url</field>
        <field type="Blockquote: Author" editor_type="LINE">author_name</field>
        <field type="Blockquote: Role / Source" editor_type="LINE">author_role</field>
      </fields>
    </widget>

    <!-- Business Hours -->
    <widget name="themeasy-business-hours">
      <fields>
        <field type="Business Hours: Exception Note" editor_type="LINE">note_text</field>
        <field type="Business Hours: Title" editor_type="LINE">title_text</field>
        <field type="Business Hours: Open Text" editor_type="LINE">badge_open_text</field>
        <field type="Business Hours: Closed Text" editor_type="LINE">badge_closed_text</field>
        <field type="Business Hours: Today Pill Text" editor_type="LINE">today_badge_text</field>
        <field type="Business Hours: Closed Label" editor_type="LINE">closed_label_text</field>
      </fields>
      <fields-in-item items_of="items">
        <field type="Business Hours: Day Label" editor_type="LINE">item_label</field>
        <field type="Business Hours: Hours" editor_type="LINE">item_hours</field>
      </fields-in-item>
    </widget>

    <!-- Button -->
    <widget name="themeasy-button">
      <fields>
        <field type="Button: Label" editor_type="LINE">button_label</field>
        <field type="Button: Hidden Label" editor_type="LINE">button_hidden_label</field>
        <field type="Button: Link" editor_type="LINK">button_link>url</field>
        <field type="Button: Video Link" editor_type="LINK">button_video_link>url</field>
        <field type="Button: Accessible Label" editor_type="LINE">button_video_label</field>
        <field type="Button: Video Link" editor_type="LINE">button_gradient_color_video_link</field>
        <field type="Button: Video Link" editor_type="LINE">button_hover_gradient_color_video_link</field>
        <field type="Button: Cursor Text" editor_type="LINE">cursor_text</field>
      </fields>
    </widget>

    <!-- Card -->
    <widget name="themeasy-card">
      <fields>
        <field type="Card: Title" editor_type="AREA">title</field>
        <field type="Card: Description" editor_type="AREA">description</field>
        <field type="Card: Label" editor_type="LINE">button_label</field>
        <field type="Card: Hidden Label" editor_type="LINE">button_hidden_label</field>
        <field type="Card: Link" editor_type="LINK">link>url</field>
        <field type="Card: Video Link" editor_type="LINE">button_gradient_color_video_link</field>
        <field type="Card: Video Link" editor_type="LINE">button_hover_gradient_color_video_link</field>
      </fields>
    </widget>

    <!-- Call to Action -->
    <widget name="themeasy-cta">
      <fields>
        <field type="Call to Action: Ribbon / Badge" editor_type="LINE">badge_text</field>
        <field type="Call to Action: Pre Title" editor_type="LINE">pre_title</field>
        <field type="Call to Action: Title" editor_type="AREA">title</field>
        <field type="Call to Action: Description" editor_type="AREA">description</field>
        <field type="Call to Action: Label" editor_type="LINE">primary_button_label</field>
        <field type="Call to Action: Link" editor_type="LINK">primary_button_link>url</field>
        <field type="Call to Action: Label" editor_type="LINE">secondary_button_label</field>
        <field type="Call to Action: Link" editor_type="LINK">secondary_button_link>url</field>
        <field type="Call to Action: Video Link" editor_type="LINE">box_background_video_link</field>
      </fields>
    </widget>

    <!-- Divider -->
    <widget name="themeasy-divider">
      <fields>
        <field type="Divider: Text" editor_type="LINE">element_text</field>
        <field type="Divider: Video Link" editor_type="LINE">line_gradient_video_link</field>
      </fields>
    </widget>

    <!-- Icon -->
    <widget name="themeasy-icon">
      <fields>
        <field type="Icon: Link" editor_type="LINK">link>url</field>
        <field type="Icon: Video Link" editor_type="LINE">shape_background_video_link</field>
        <field type="Icon: Video Link" editor_type="LINE">icon_background_video_link</field>
        <field type="Icon: Cursor Text" editor_type="LINE">cursor_text</field>
      </fields>
    </widget>

    <!-- Icon List -->
    <widget name="themeasy-icon-list">
      <fields>
        <field type="Icon List: Title" editor_type="LINE">title</field>
      </fields>
      <fields-in-item items_of="icon_list">
        <field type="Icon List: Text" editor_type="AREA">text</field>
        <field type="Icon List: Badge" editor_type="LINE">badge_text</field>
        <field type="Icon List: Counter" editor_type="LINE">counter</field>
        <field type="Icon List: URL" editor_type="LINK" key_of="link">url</field>
      </fields-in-item>
    </widget>

    <!-- Image -->
    <widget name="themeasy-image">
      <fields>
        <field type="Image: Image Caption" editor_type="LINE">image_caption</field>
        <field type="Image: Custom Link" editor_type="LINK">image_custom_link>url</field>
        <field type="Image: Cursor Text" editor_type="LINE">cursor_text</field>
      </fields>
    </widget>

    <!-- Logo Wall -->
    <widget name="themeasy-logo-wall">
      <fields-in-item items_of="logos">
        <field type="Logo Wall: Name" editor_type="LINE">logo_name</field>
        <field type="Logo Wall: Link" editor_type="LINK" key_of="logo_link">url</field>
      </fields-in-item>
    </widget>

    <!-- Pricing Table -->
    <widget name="themeasy-pricing-table">
      <fields>
        <field type="Pricing Table: Label for Toggle Off" editor_type="LINE">toggle_label_off</field>
        <field type="Pricing Table: Label for Toggle On" editor_type="LINE">toggle_label_on</field>
        <field type="Pricing Table: Yearly Badge Text" editor_type="LINE">toggle_label_on_badge</field>
        <field type="Pricing Table: Video Link" editor_type="LINE">button_gradient_color_video_link</field>
        <field type="Pricing Table: Video Link" editor_type="LINE">button_hover_gradient_color_video_link</field>
      </fields>
      <fields-in-item items_of="pricing_table">
        <field type="Pricing Table: Plan Name" editor_type="LINE">plan_name</field>
        <field type="Pricing Table: Currency Symbol" editor_type="LINE">price_prefix</field>
        <field type="Pricing Table: Billing Period" editor_type="LINE">price_suffix</field>
        <field type="Pricing Table: Billing Period (Yearly)" editor_type="LINE">price_suffix_yearly</field>
        <field type="Pricing Table: Badge Text" editor_type="LINE">featured_badge_text</field>
        <field type="Pricing Table: Features List" editor_type="AREA">features_list</field>
        <field type="Pricing Table: Label" editor_type="LINE">button_label</field>
        <field type="Pricing Table: Hidden Label" editor_type="LINE">button_hidden_label</field>
        <field type="Pricing Table: Link" editor_type="LINK" key_of="link">url</field>
      </fields-in-item>
    </widget>

    <!-- Section Intro -->
    <widget name="themeasy-section-intro">
      <fields>
        <field type="Section Intro: Eyebrow" editor_type="LINE">eyebrow</field>
        <field type="Section Intro: Title" editor_type="AREA">title</field>
        <field type="Section Intro: Description" editor_type="AREA">description</field>
        <field type="Section Intro: Label" editor_type="LINE">primary_button_label</field>
        <field type="Section Intro: Link" editor_type="LINK">primary_button_link>url</field>
        <field type="Section Intro: Label" editor_type="LINE">secondary_button_label</field>
        <field type="Section Intro: Link" editor_type="LINK">secondary_button_link>url</field>
        <field type="Section Intro: Video Link" editor_type="LINE">frame_background_video_link</field>
      </fields>
    </widget>

    <!-- Social Profiles -->
    <widget name="themeasy-social-profiles">
      <fields-in-item items_of="profiles">
        <field type="Social Profiles: URL" editor_type="LINK" key_of="url">url</field>
        <field type="Social Profiles: Accessible Label" editor_type="LINE">label</field>
      </fields-in-item>
    </widget>

    <!-- Steps -->
    <widget name="themeasy-steps">
      <fields-in-item items_of="steps_items">
        <field type="Steps: Title" editor_type="AREA">title</field>
        <field type="Steps: Content" editor_type="VISUAL">content</field>
      </fields-in-item>
    </widget>

    <!-- Team Member -->
    <widget name="themeasy-team-member">
      <fields>
        <field type="Team Member: Name" editor_type="LINE">member_name</field>
        <field type="Team Member: Role / Position" editor_type="LINE">member_role</field>
        <field type="Team Member: Bio" editor_type="AREA">member_bio</field>
        <field type="Team Member: Link" editor_type="LINK">link>url</field>
        <field type="Team Member: Video Link" editor_type="LINE">overlay_background_video_link</field>
        <field type="Team Member: Video Link" editor_type="LINE">role_background_video_link</field>
      </fields>
      <fields-in-item items_of="socials">
        <field type="Team Member: Label" editor_type="LINE">social_label</field>
        <field type="Team Member: Link" editor_type="LINK" key_of="social_link">url</field>
      </fields-in-item>
    </widget>

    <!-- Testimonial -->
    <widget name="themeasy-testimonial">
      <fields>
        <field type="Testimonial: Name" editor_type="LINE">person_name</field>
        <field type="Testimonial: Occupation Info" editor_type="LINE">occupation_info</field>
        <field type="Testimonial: Testimonial Text" editor_type="AREA">testimonial_text</field>
        <field type="Testimonial: Video Link" editor_type="LINE">occupation_info_background_video_link</field>
      </fields>
    </widget>

    <!-- Video -->
    <widget name="themeasy-video">
      <fields>
        <field type="Video: YouTube URL" editor_type="LINK">youtube_url</field>
        <field type="Video: Vimeo URL" editor_type="LINK">vimeo_url</field>
        <field type="Video: File URL" editor_type="LINK">hosted_external_url>url</field>
        <field type="Video: Badge" editor_type="LINE">badge_text</field>
        <field type="Video: Accessible Label" editor_type="LINE">video_label</field>
      </fields>
    </widget>

  </elementor-widgets>
</wpml-config>
